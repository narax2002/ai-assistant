# === Required for Discord bot (not needed for API-only mode) ===
DISCORD_BOT_TOKEN=your_discord_bot_token

# === General ===
LOG_LEVEL=INFO
MAX_REPLY_CHARS=1900
# DISCORD_DEV_GUILD_ID=            # instant slash command sync during dev

# === Ollama (local, always active) ===
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_TIMEOUT_SECONDS=60
# SYSTEM_PROMPT=You are a practical personal AI assistant. Respond clearly and concisely.
# ENABLE_PROOFREAD=true

# === CLI providers (subscription-based, no extra cost) ===
# CLAUDE_CLI_ENABLED=false
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_TIMEOUT_SECONDS=120
# CODEX_CLI_ENABLED=false
# CODEX_CLI_PATH=codex
# CODEX_CLI_TIMEOUT_SECONDS=120

# === API providers (paid — enabled when key is set) ===
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=60
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_TIMEOUT_SECONDS=60

# === History storage ===
# HISTORY_DB_PATH=data/research_history.db
MAX_HISTORY_RECORDS=200
MAX_HISTORY_SIZE_MB=50

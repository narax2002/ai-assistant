DISCORD_BOT_TOKEN=your_discord_bot_token
COMMAND_PREFIX=!
LOG_LEVEL=INFO
ENABLE_PROOFREAD=true
ENABLE_GOOGLE_CALENDAR=false
MAX_REPLY_CHARS=1900

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60

GOOGLE_CALENDAR_CREDENTIALS_PATH=data/credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=data/token.json
GOOGLE_CALENDAR_ID=primary

SYSTEM_PROMPT=You are a practical personal AI assistant. Respond clearly and concisely.

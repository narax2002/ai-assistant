DISCORD_BOT_TOKEN=your_discord_bot_token
LOG_LEVEL=INFO
MAX_REPLY_CHARS=1900

# Optional: set to sync slash commands to a specific guild during development
# DISCORD_DEV_GUILD_ID=

# LLM configuration
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_TIMEOUT_SECONDS=60
# SYSTEM_PROMPT=You are a practical personal AI assistant. Respond clearly and concisely.

# History storage
# HISTORY_DB_PATH=data/research_history.db
MAX_HISTORY_RECORDS=200
MAX_HISTORY_SIZE_MB=50
